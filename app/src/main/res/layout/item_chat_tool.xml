<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="8dp"
    android:paddingVertical="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bubble_tool"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvToolIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔍"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvToolHeader"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:textColor="@color/accent_blue"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="Ricerca Web: meteo firenze" />

            <TextView
                android:id="@+id/tvToolStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_status"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:textColor="@color/secondary"
                android:textSize="10sp"
                tools:text="✓ Completato" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvToolSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="3"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            tools:text="Risultati DuckDuckGo: A Firenze oggi cielo sereno con 24°C..." />
    </LinearLayout>
</LinearLayout>
