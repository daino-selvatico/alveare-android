<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:padding="12dp">

    <!-- Top Navigation & Room Status Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_launcher_foreground"
            android:contentDescription="@string/app_name" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvAppName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvRoomSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Salotto • Smart Satellite"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Connection Status Pill (Clickable) -->
        <LinearLayout
            android:id="@+id/statusPill"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_pill_status"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp">

            <View
                android:id="@+id/statusDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/ic_launcher_background"
                android:backgroundTint="@color/accent_red" />

            <TextView
                android:id="@+id/tvConnectionStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/status_disconnected"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <ImageView
                android:id="@+id/ivReconnectStatus"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/ic_refresh"
                app:tint="@color/text_muted"
                android:contentDescription="@string/action_reconnect" />
        </LinearLayout>

        <!-- Privacy Mute Quick Toggle Button (>=48dp touch target) -->
        <ImageButton
            android:id="@+id/btnQuickMute"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="2dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_privacy_mute"
            android:src="@drawable/ic_mic"
            app:tint="@color/text_secondary" />

        <!-- Clear Memory / Delete Chat Button (>=48dp touch target) -->
        <ImageButton
            android:id="@+id/btnClearMemory"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_clear_memory"
            android:src="@drawable/ic_delete"
            app:tint="@color/text_muted" />

        <!-- Settings Button (>=48dp touch target) -->
        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_settings"
            android:src="@drawable/ic_settings"
            app:tint="@color/text_secondary" />
    </LinearLayout>

    <!-- Two-Mode Selector (Assistente vs Live) -->
    <LinearLayout
        android:id="@+id/layoutModeSelector"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_card"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="3dp"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnModeAssistant"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="🤖 Assistente"
            android:textSize="12sp"
            android:textStyle="bold"
            app:cornerRadius="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnModeLive"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="⚡ Live (Continuo)"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            android:textStyle="bold"
            app:cornerRadius="10dp" />
    </LinearLayout>

    <!-- Disconnected Warning Banner (Prominent banner when offline) -->
    <LinearLayout
        android:id="@+id/layoutConnectionBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/layoutModeSelector">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_refresh"
            app:tint="@color/primary"
            android:contentDescription="@string/action_reconnect" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvBannerTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_disconnected"
                android:textColor="@color/primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvBannerSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tocca per riconnettere il satellite"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBannerConnect"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minHeight="48dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="0dp"
            android:text="Connetti"
            android:textColor="@color/on_primary"
            android:textSize="11sp"
            app:backgroundTint="@color/primary"
            app:cornerRadius="18dp" />
    </LinearLayout>

    <!-- Central Visualizer Orb & State Indicator -->
    <com.alveare.satellite.ui.VisualizerView
        android:id="@+id/visualizerView"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:layout_marginTop="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutConnectionBanner" />

    <!-- Current State Label -->
    <TextView
        android:id="@+id/tvStateLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:text="@string/status_ready"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/visualizerView" />

    <!-- Badges Row -->
    <LinearLayout
        android:id="@+id/badgesRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvStateLabel">

        <TextView
            android:id="@+id/badgeTtsMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_status"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="🔊 Kokoro 24kHz"
            android:textColor="@color/primary"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/badgeLatency"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_pill_status"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="⚡ 0 ms"
            android:textColor="@color/text_muted"
            android:textSize="10sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/badgeMemory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_pill_status"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="🧠 Memoria: 0 turni"
            android:textColor="@color/accent_blue"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Live Microphone Level & Activity Bar -->
    <LinearLayout
        android:id="@+id/layoutMicLevel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@id/badgesRow">

        <TextView
            android:id="@+id/tvMicLevelLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎙️ Mic: pronto"
            android:textColor="@color/text_muted"
            android:textSize="10sp" />

        <ProgressBar
            android:id="@+id/pbMicLevel"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:max="100"
            android:progress="0"
            android:progressTint="@color/secondary" />
    </LinearLayout>

    <!-- Scrollable Conversation History -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvChatHistory"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="6dp"
        android:clipToPadding="false"
        android:paddingBottom="4dp"
        app:layout_constraintBottom_toTopOf="@id/bottomControls"
        app:layout_constraintTop_toBottomOf="@id/layoutMicLevel" />

    <!-- Empty Chat Hint -->
    <LinearLayout
        android:id="@+id/layoutEmptyChat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="visible"
        app:layout_constraintBottom_toTopOf="@id/bottomControls"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutMicLevel">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_mic"
            app:tint="@color/text_muted"
            android:contentDescription="@string/action_tap_to_speak" />

        <TextView
            android:id="@+id/tvEmptyChatHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="Nessuna conversazione ancora\nDì 'Ehi Alveare' o tocca il microfono"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Bottom Controls: Privacy Mute, Big Central Mic, Interrupt/Stop -->
    <LinearLayout
        android:id="@+id/bottomControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="4dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Privacy Mute Button (>=48dp touch target) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBottomMute"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:contentDescription="@string/action_privacy_mute"
            app:cornerRadius="24dp"
            app:icon="@drawable/ic_mic"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconTint="@color/text_secondary"
            app:strokeColor="@color/surface_card_stroke" />

        <!-- Spacer -->
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Big Mic Activation Button (Tap-to-Talk) -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnMic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/action_tap_to_speak"
            android:src="@drawable/ic_mic"
            app:backgroundTint="@color/primary"
            app:elevation="6dp"
            app:fabSize="normal"
            app:tint="@color/on_primary" />

        <!-- Spacer -->
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Interrupt / Stop Button (>=48dp touch target) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnInterrupt"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:contentDescription="@string/action_interrupt"
            android:visibility="invisible"
            app:backgroundTint="@color/accent_red"
            app:cornerRadius="24dp"
            app:icon="@drawable/ic_stop"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconTint="@color/white" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
