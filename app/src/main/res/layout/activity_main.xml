<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:padding="16dp">

    <!-- Top Navigation & Status Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_launcher_foreground"
            android:contentDescription="@string/app_name" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvRoomSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Salotto • Smart Satellite"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Connection Status Pill (Clickable to reconnect) -->
        <LinearLayout
            android:id="@+id/statusPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_status"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp">

            <View
                android:id="@+id/statusDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/ic_launcher_background"
                android:backgroundTint="@color/accent_red" />

            <TextView
                android:id="@+id/tvConnectionStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/status_disconnected"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <ImageView
                android:id="@+id/ivReconnectStatus"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/ic_refresh"
                app:tint="@color/text_muted" />
        </LinearLayout>

        <!-- Clear Memory / Delete Chat Button -->
        <ImageButton
            android:id="@+id/btnClearMemory"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Cancella Memoria / Pulisci Chat"
            android:src="@drawable/ic_delete"
            app:tint="@color/text_muted" />

        <!-- Settings Button -->
        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="2dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_settings"
            android:src="@drawable/ic_settings" />
    </LinearLayout>

    <!-- Disconnected Warning Banner (Prominent banner when offline) -->
    <LinearLayout
        android:id="@+id/layoutConnectionBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp"
        android:visibility="visible"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_refresh"
            app:tint="@color/primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvBannerTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Server Alveare Disconnesso"
                android:textColor="@color/primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvBannerSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tocca per connetterti al server in LAN"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBannerConnect"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:paddingHorizontal="14dp"
            android:paddingVertical="0dp"
            android:text="Connetti"
            android:textColor="@color/on_primary"
            android:textSize="12sp"
            app:backgroundTint="@color/primary"
            app:cornerRadius="18dp" />
    </LinearLayout>

    <!-- Central Glowing Visualizer Orb (Compact size to leave room for Chat History) -->
    <com.alveare.satellite.ui.VisualizerView
        android:id="@+id/visualizerView"
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:layout_marginTop="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutConnectionBanner" />

    <!-- Current State Label -->
    <TextView
        android:id="@+id/tvStateLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/status_ready"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/visualizerView" />

    <!-- Badges Row (Listen Mode / TTS Mode / Latency) -->
    <LinearLayout
        android:id="@+id/badgesRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvStateLabel">

        <TextView
            android:id="@+id/badgeListenMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_status"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="🎙️ Sempre in ascolto"
            android:textColor="@color/secondary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/badgeTtsMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_pill_status"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="🔊 TTS: Kokoro 24kHz"
            android:textColor="@color/primary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/badgeLatency"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_pill_status"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="⚡ 0 ms"
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Live Microphone Level & Activity Bar -->
    <LinearLayout
        android:id="@+id/layoutMicLevel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        app:layout_constraintTop_toBottomOf="@id/badgesRow">

        <TextView
            android:id="@+id/tvMicLevelLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎙️ Mic: pronto"
            android:textColor="@color/text_muted"
            android:textSize="10sp" />

        <ProgressBar
            android:id="@+id/pbMicLevel"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:max="100"
            android:progress="0"
            android:progressTint="@color/secondary" />
    </LinearLayout>

    <!-- Real-Time Scrollable Conversation History (Chat RecyclerView) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvChatHistory"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="8dp"
        android:clipToPadding="false"
        android:paddingBottom="4dp"
        app:layout_constraintBottom_toTopOf="@id/bottomControls"
        app:layout_constraintTop_toBottomOf="@id/layoutMicLevel" />

    <!-- Empty State View (Shown when no chat messages) -->
    <LinearLayout
        android:id="@+id/layoutEmptyChat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="visible"
        app:layout_constraintBottom_toTopOf="@id/bottomControls"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutMicLevel">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_mic"
            app:tint="@color/text_muted" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Nessuna conversazione ancora\nParla o tocca il microfono per iniziare"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Bottom Action Controls -->
    <RelativeLayout
        android:id="@+id/bottomControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Floating Mic Button -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnMic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:contentDescription="@string/action_tap_to_speak"
            android:src="@drawable/ic_mic"
            app:backgroundTint="@color/primary"
            app:elevation="8dp"
            app:fabSize="normal"
            app:tint="@color/on_primary" />

        <!-- Floating Interrupt Button (Appears during assistant speech or processing) -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnInterrupt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="24dp"
            android:layout_toEndOf="@id/btnMic"
            android:contentDescription="@string/action_interrupt"
            android:src="@drawable/ic_refresh"
            android:visibility="gone"
            app:backgroundTint="@color/accent_red"
            app:elevation="4dp"
            app:fabSize="mini"
            app:tint="@color/white" />
    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
